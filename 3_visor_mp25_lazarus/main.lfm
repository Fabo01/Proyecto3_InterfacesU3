  object GraficoMP25: TChart
    Left = 8
    Height = 278
    Top = 34
    Width = 964
    AxisList = <    
      item
        Grid.Color = clGray
        Grid.Style = psDot
        Marks.LabelBrush.Style = bsClear
        Minors = <>
        Title.LabelFont.Orientation = 900
        Title.LabelFont.Style = [fsBold]
        Title.Visible = True
        Title.Caption = '[ug/m3]'
        Title.LabelBrush.Style = bsClear
      end    
      item
        Alignment = calBottom
        Grid.Color = clGray
        Grid.Style = psDot
        Intervals.MinLength = 10
        Intervals.NiceSteps = '1'
        Marks.LabelBrush.Style = bsClear
        Minors = <>
        Title.LabelFont.Style = [fsBold]
        Title.Visible = True
        Title.Caption = 'Sampling MP 2.5um'
        Title.LabelBrush.Style = bsClear
      end>
    Extent.UseXMax = True
    Extent.UseXMin = True
    Extent.UseYMax = True
    Extent.UseYMin = True
    Extent.XMax = 29
    Extent.XMin = 0
    Extent.YMax = 200
    Extent.YMin = 0
    Legend.Alignment = laTopRight
    Legend.Frame.Visible = True
    Legend.Visible = True
    Title.Brush.Style = bsClear
    Title.Font.Color = clBlack
    Title.Font.Height = -15
    Title.Font.Style = [fsBold]
    Title.Text.Strings = (
      'Material Particulado 2.5 um'
    )
    Title.Visible = True
    Anchors = [akTop, akLeft, akRight, akBottom]
    DoubleBuffered = True
    object SerieMP25: TLineSeries
      Title = 'MP 2.5 um'
      LinePen.Color = clRed
      LinePen.Width = 2
      Marks.Clipped = False
      Marks.Distance = 10
      Marks.Format = '%0:.9g'
      Marks.Frame.Color = clBlack
      Marks.Frame.Visible = True
      Marks.LabelBrush.Color = 16775408
      Marks.LabelBrush.Style = bsSolid
      Marks.LabelFont.Color = clBlack
      Marks.LinkPen.Visible = True
      Marks.Style = smsValue
      Marks.Visible = True
      Pointer.Brush.Color = 14194744
      Pointer.HorizSize = 4
      Pointer.Pen.Color = clNavy
      Pointer.Style = psRectangle
      Pointer.VertSize = 4
      Pointer.Visible = True
      SeriesColor = clRed
      ShowPoints = True
    end
  end
